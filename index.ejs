<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jewelry</title>
</head>
<body>
    <form action="/register" method="POST">
        <label for="item_type">Item Type</label>
        <input name="item_type" placeholder="Item Type" required>
        <br>
        <label for="metal_type">Metal Type</label>
        <input name="metal_type" placeholder="Metal Type" required>
        <br>
        <label for="stone_type">Stone Type</label>
        <input name="stone_type" placeholder="Stone Type" required>
        <br>
        <label for="price">Price (Php)</label>
        <input name="price" placeholder="0.00" type="number" step="0.01" min="0" required>
        <br>
        <label for="karat">Karat</label>
        <input name="karat" placeholder="18" type="number" required>
        <br>
        <button type="Submit">Submit</button>
    </form>
</body>
</html>